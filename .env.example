# API
PORT=4000
DATABASE_URL="file:./dev.db"
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=0
SESSION_TTL_HOURS=12
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Minecraft server
MC_HOST=127.0.0.1
MC_PORT=25565
MC_QUERY_PORT=25565
RCON_PORT=25575
RCON_PASSWORD=change-me
MC_CONTAINER_NAME=minecraft
DOCKER_API_URL=http://docker-proxy:2375

# Mail sent by the site: From is SMTP_FROM (no-reply), contact form messages go to CONTACT_TO.
# Without SMTP_HOST the contact form answers 503.
# SMTP_HOST=mailserver
# SMTP_PORT=587
# SMTP_USER=no-reply@spiatek.pl
# SMTP_PASSWORD=change-me
# SMTP_FROM=no-reply@spiatek.pl
# CONTACT_TO=kontakt@spiatek.pl

# Docker Compose (production). Compose reads this file for variable substitution.
# Inside the stack the API reaches Minecraft as "minecraft", so MC_HOST above is ignored there.
# IMAGE_PREFIX=ghcr.io/<owner>/<repo>
# IMAGE_TAG=latest
# MC_DATA_DIR=/home/ubuntu/server
# MC_MEMORY=3G
# MC_IMAGE_TAG=java25
