generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Explicit so the output doesn't depend on whether a tsconfig is visible when generating (e.g. in Docker).
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id])
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
